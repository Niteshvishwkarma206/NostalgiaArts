# Copy this file to .env and fill in your Firebase project credentials.
# If these are left blank, the app automatically runs in Sandbox Mode
# (data is stored in the browser's localStorage instead of Firebase).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The email that is granted admin-dashboard access after signing in.
VITE_ADMIN_EMAIL=nv3600714@gmail.com
